# Supabase (Phase 9). Copy to `.env` and fill from your project's Settings -> API.
# The anon key is browser-safe; tenant isolation is enforced by database RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key is SECRET — never put it here or in any VITE_* var. It is set
# only as an Edge Function secret (see supabase/functions), never shipped to the browser.
